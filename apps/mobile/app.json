{
  "expo": {
    "name": "مكتبي",
    "slug": "maktabi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "maktabi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maktabi.mobile"
    },
    "android": {
      "package": "com.maktabi.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B2949"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
