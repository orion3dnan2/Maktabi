{
  "expo": {
    "name": "مكتبي",
    "slug": "maktabi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "maktabi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.maktabi.mobile" },
    "android": { "package": "com.maktabi.mobile", "adaptiveIcon": { "backgroundColor": "#0B2949" } },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-font"],
    "experiments": { "typedRoutes": true },
    "extra": { "router": { "origin": false } }
  }
}
